# === DATABASE (Supabase) ===
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
# === AUTH ===
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_secure_secret
SECRET_DEMO_USER=
SECRET_DEMO_PASSWORD=
DEMO_USER_ID=demo

# === Modes ===
# Demo mode disables Prisma usage when DATABASE_URL is missing
# or when running the project as a standalone portfolio demo.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Analytics mode:
# - demo: browser/localStorage-backed analytics demo
# - prod: server/API-backed analytics with database persistence
ANALYTICS_MODE=prod
NEXT_PUBLIC_ANALYTICS_MODE=prod

# === SUPABASE (Optional for Client SDK) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=